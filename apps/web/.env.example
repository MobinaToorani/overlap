# Copy to .env.local for development. Never commit a filled-in copy —
# see docs/engineering-spec.md §10 for the full reference and which worker
# role (overlap_worker, INV-1) must be used for DATABASE_URL in the worker.

DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Migration-time only (used by `pnpm db:migrate`, not read by the running
# app) — sets the password for the overlap_worker DB role created by
# src/server/db/sql/0001_guard_invariants.sql (FIX-4). Not in
# engineering-spec.md §10's list since it's not an app runtime var. Skipping
# this is fine until T9 (calendar sync); db:migrate warns and continues
# without creating the role if it's unset.
OVERLAP_WORKER_DB_PASSWORD=
