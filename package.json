{
  "name": "overlap",
  "private": true,
  "version": "0.1.0",
  "description": "Overlap — a scheduling and planning app for adult friend groups.",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @overlap/web dev",
    "build": "pnpm --filter @overlap/web build",
    "lint": "pnpm -r --if-present lint",
    "verify:docs": "node scripts/verify-docs.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "db:generate": "pnpm --filter @overlap/web db:generate",
    "db:migrate": "pnpm --filter @overlap/web db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
